{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)docker-bake\\.hcl$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+default\\s*=\\s*\"(?<currentValue>[^\"]+)\"\\s*}\\s*variable \"UPSTREAM_COMMIT\"\\s*{\\s*default\\s*=\\s*\"(?<currentDigest>[a-f0-9]{40})\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["images/*/docker-bake.hcl"],
      "additionalBranchPrefix": "upstream-",
      "commitMessageTopic": "upstream {{depName}}",
      "labels": ["renovate", "upstream"]
    }
  ]
}
